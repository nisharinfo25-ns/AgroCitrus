# ---------------------------------------------------------------------------
# CitrusGuard - environment configuration
# Copy to `.env.local` and fill in real values.  NEVER commit `.env*`.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://eczfukabevxcpdbolowm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJwbW9hZmRpa2lsYnBjeGJibXlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3NTA2MzUsImV4cCI6MjEwNjMyNjYzNX0.6a6PP_D8jAXjmYkywcdndueFJwabwh2SIO-UPSz5_S4

# ---------------------------------------------------------------------------
# SERVER ONLY - never prefix with NEXT_PUBLIC_, never send to the browser.
# Required for: dataset upload, model artifact upload, profile bootstrap,
# admin-only dataset/model operations.
# Supabase Dashboard -> Project Settings -> API Keys -> service_role
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Dataset source (auto-download). Optional overrides - see README §Dataset.
# ---------------------------------------------------------------------------
# Explicit, verified public source. No credentials required.
CITRUSGUARD_DATASET_URL=https://data.mendeley.com/public-api/zip/3f83gxmv57/download/2
CITRUSGUARD_DATASET_LANDING_PAGE=https://data.mendeley.com/datasets/3f83gxmv57/2
CITRUSGUARD_DATASET_NAME=citrus-fruits-leaves-v2
CITRUSGUARD_DATASET_VERSION=2
# SHA-256 of the publisher archive. Leave empty to record the checksum of
# whatever is downloaded (recorded in dataset_metadata, never invented).
CITRUSGUARD_DATASET_SHA256=fc82592e9caebda988b278f0f2f965dbd0ae1464f6d920aa4ca9654da7ab19f7
# How many times the downloader retries transient network failures.
CITRUSGUARD_DATASET_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Local filesystem locations (git-ignored). Absolute paths are resolved
# relative to the repository root.
# ---------------------------------------------------------------------------
CITRUSGUARD_DATA_DIR=data
CITRUSGUARD_MODEL_DIR=models
CITRUSGUARD_REPORT_DIR=reports

# ---------------------------------------------------------------------------
# Prediction / inference
# ---------------------------------------------------------------------------
# Python interpreter used to spawn the ML inference worker.
CITRUSGUARD_PYTHON=python
# Max uploaded image size in megabytes.
CITRUSGUARD_MAX_UPLOAD_MB=10
# Predictions below this confidence are flagged as low-confidence.
CITRUSGUARD_MIN_CONFIDENCE=0.55
# Where the downloaded production model artifact is cached on the server.
CITRUSGUARD_MODEL_CACHE_DIR=.cache/citrusguard/models

# ---------------------------------------------------------------------------
# First admin account. Used only by `npm run ml:supabase:provision` /
# `scripts/bootstrap-admin.ts` to promote an EXISTING signed-up user.
# The user must sign up through the UI first. No hardcoded passwords.
# ---------------------------------------------------------------------------
CITRUSGUARD_ADMIN_EMAIL=
