{
  "name": "citrusguard",
  "version": "1.0.0",
  "private": true,
  "description": "CitrusGuard - AI-based citrus fruit & leaf disease detection using explainable deep learning.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ml:install": "python -m pip install -r requirements.txt",
    "ml:dataset:status": "node scripts/run-ml.mjs dataset status",
    "ml:dataset:download": "node scripts/run-ml.mjs dataset download",
    "ml:dataset:verify": "node scripts/run-ml.mjs dataset verify",
    "ml:dataset:prepare": "node scripts/run-ml.mjs dataset prepare",
    "ml:model:train": "node scripts/run-ml.mjs model train",
    "ml:model:evaluate": "node scripts/run-ml.mjs model evaluate",
    "ml:model:export": "node scripts/run-ml.mjs model export",
    "ml:model:status": "node scripts/run-ml.mjs model status",
    "ml:supabase:provision": "node scripts/run-ml.mjs supabase provision",
    "ml:supabase:sync-dataset": "node scripts/run-ml.mjs supabase sync-dataset",
    "ml:supabase:push-model": "node scripts/run-ml.mjs supabase push-model",
    "ml:supabase:status": "node scripts/run-ml.mjs supabase status",
    "ml:model:promote": "node scripts/run-ml.mjs model promote",
    "calibrate:sharpness": "python scripts/calibrate-sharpness.py",
    "benchmark:inference": "python scripts/benchmark-inference.py",
    "verify:serving": "python scripts/verify-serving-accuracy.py",
    "smoke:worker": "python scripts/worker-smoke.py",
    "admin:bootstrap": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "admin:users": "node --experimental-strip-types scripts/bootstrap-admin.ts --list"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.26",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
